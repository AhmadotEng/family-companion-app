# Required for the AI Helper. The rest of the app works without it, but the
# controlled assistant and AI-generated reconnection plans return 503 until set.
GEMINI_API_KEY="replace-with-your-server-side-key"

# Optional model override. Keep this server-side; never use a VITE_ prefix.
GEMINI_MODEL="gemini-3.5-flash"

# Maximum wall-clock wait for one AI provider turn (100-120000 ms).
# Invalid values fall back to the 60-second default. Slow connections can use
# up to 120000 ms, but the UI will remain busy until the provider returns.
AGENT_PROVIDER_TIMEOUT_MS="60000"

# Public origin embedded in invitation links in deployed environments.
# Local development derives http://localhost:4000 from the request.
PUBLIC_APP_URL="http://localhost:4000"

# Runtime storage. Both paths are ignored by Git.
DATABASE_PATH="data/family-companion.sqlite"
UPLOAD_PATH="data/uploads"

# Optional private-media quotas in bytes. Defaults: 100 MiB per user and
# 500 MiB per family. Upload requests are also rate limited.
MEDIA_USER_QUOTA_BYTES="104857600"
MEDIA_FAMILY_QUOTA_BYTES="524288000"

# Optional server port.
PORT="4000"

# Defaults to 127.0.0.1 for local safety. Set deliberately when exposing the
# server through a trusted container or reverse proxy.
HOST="127.0.0.1"

# Number of trusted reverse-proxy hops. Production defaults to 1 because the
# app binds to loopback behind one TLS proxy. Set the exact deployment value;
# never use an unrestricted `trust proxy` setting.
TRUST_PROXY_HOPS="1"
